# Supabase (auth). Publishable key is safe to ship in the client.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Native maps (react-native-maps). Android requires a Google Maps SDK key; iOS falls back to Apple Maps.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
